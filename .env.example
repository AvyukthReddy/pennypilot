# Postgres
POSTGRES_USER=pennypilot
POSTGRES_PASSWORD=pennypilot
POSTGRES_DB=pennypilot
DATABASE_URL=postgresql+psycopg://pennypilot:pennypilot@postgres:5432/pennypilot

# Redis
REDIS_URL=redis://redis:6379/0

# AI provider (worker document understanding — optional; skipped if unset).
# Any OpenAI-compatible chat completions endpoint works — swap model/provider
# here without touching worker code. Defaults to Hugging Face's Inference
# Providers router (get a token at hf.co/settings/tokens with "Make calls to
# Inference Providers" permission) serving Qwen2.5-VL-7B-Instruct for free.
AI_BASE_URL=https://router.huggingface.co/v1
MODEL_API_KEY=
# HF_TOKEN also works as a fallback if MODEL_API_KEY is unset (for now, since
# Hugging Face is the default provider) — set either one.
AI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:featherless-ai

# Backend
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_URL=https://<project-ref>.supabase.co
